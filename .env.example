# Gorgias credentials
# Your Gorgias subdomain, e.g. yourstore.gorgias.com
GORGIAS_DOMAIN=yourstore.gorgias.com

# The email address associated with your Gorgias account
GORGIAS_EMAIL=you@yourstore.com

# Your Gorgias API key (Settings → REST API)
GORGIAS_API_KEY=your_gorgias_api_key_here

# Anthropic API key (https://console.anthropic.com/settings/api-keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: port for local development (default: 5000)
# PORT=5000
